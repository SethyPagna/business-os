# clients/example.env -- every variable one client's Worker config needs, with obviously fake values.
#
# Copy this file to clients/<name>.env (that path is gitignored: a real client's values are never
# committed), fill it in, then render the config from it:
#
#   node ops/scripts/client/render-wrangler.mjs --env-file clients/<name>.env
#
# That writes cloudflare/wrangler.toml, plus cloudflare/wrangler.free.toml when PLAN_TIER is free. Both
# are generated and gitignored; cloudflare/wrangler.template.toml is the only committed Worker config.
#
# In GitHub the same names are the variables of the environment called like the client (Settings,
# Environments, <name>, Variables), set by the owner; the workflows render from them. Their secrets are
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID, never listed here. docs/setup/multi-client.md has the
# full procedure.
#
# Rules: every variable below must be present, except the optional shop identity and NOTE_ lines.
# A variable the client has no value for (Sentry, e-mail, Google, custom domains) is written as the
# word none; leaving it out is an error, so that a forgotten variable cannot quietly switch a feature
# off. Quote nothing except the optional NOTE_ lines. The renderer checks every value against its
# format and never prints a value in an error.

# ---- the client ----

# Short lowercase name of the client. It must equal the GitHub environment name, and the workflows
# refuse to run when the environment variable CLIENT_SLUG differs from the client chosen.
CLIENT_SLUG=example

# Workers plan of the Cloudflare account: paid or free. free also renders wrangler.free.toml (the file
# `npm run deploy:free` uses).
PLAN_TIER=paid

# ---- Worker configuration ----

# Cloudflare account id (32 hex). Dashboard, right-hand side of the account home page.
CF_ACCOUNT_ID=00000000000000000000000000000000

# Name of this client's Worker. Unique within its Cloudflare account.
WORKER_NAME=example-shop

# true serves the Worker on its workers.dev address as well, which is the way in when the custom
# domain is down.
# (optional; default false)
WORKERS_DEV=false

# Custom domains of the Worker, comma separated (the public host and the admin host). Each must be on
# a zone of this account. none when the client is served from workers.dev only.
ROUTES=example.com,admin.example.com

# Where the Worker is pinned to run, next to the D1 primary (Smart Placement region), for example
# aws:ap-southeast-1 for Singapore.
PLACEMENT_REGION=aws:ap-southeast-1

# Name of the main D1 database. Unique within the account.
D1_MAIN_NAME=example-shop-db

# Id of the main D1 database. The workflows refuse to write unless it equals the GitHub variable
# D1_MAIN_ID.
D1_MAIN_ID=00000000-0000-4000-8000-000000000001

# Name of the import-staging D1 database. Unique within the account.
D1_IMPORT_NAME=example-shop-import-db

# Id of the import-staging D1 database.
D1_IMPORT_ID=00000000-0000-4000-8000-000000000002

# R2 bucket that holds uploaded files (the ASSETS binding). Unique within the account.
R2_BUCKET=example-shop-assets

# Id of the KV namespace used as the edge cache (the CACHE binding).
KV_CACHE_ID=00000000000000000000000000000003

# Analytics Engine dataset the Worker writes request metrics to. Unique within the account. none
# leaves the binding out (an account without Analytics Engine, error 10089); the code then skips
# analytics, and the Metrics workflow has nothing to read.
ANALYTICS_DATASET=Example_Shop_Analytics

# Rate-limit namespace id, an integer unique among the rate limiters of the account, so pick one no
# other client of that account uses. none leaves the limiter out (the code then skips the check).
RATELIMIT_NAMESPACE_ID=2001

# true binds Cloudflare Images (server-side resizing). false leaves the binding out; the code then
# serves originals.
# (optional; default true)
IMAGES_BINDING=true

# true binds the deployed version id, which keys the storefront edge cache. false leaves the binding
# out.
# (optional; default true)
VERSION_METADATA=true

# Prefix of the four queues <prefix>-import, <prefix>-import-dlq, <prefix>-media and
# <prefix>-backup-assets. The code tells the four apart by that ending, so another prefix works from
# release 6.0.959 on (needed only when two clients share one Cloudflare account); the default is the
# name every older release expects. Create the queues before the first deploy.
# (optional; default business-os)
QUEUE_PREFIX=example-shop

# Public storefront address, no trailing slash.
PUBLIC_URL=https://example.com

# Admin and till address, no trailing slash. The release live checks and the ops jobs call this site;
# the workflows refuse to run unless it equals the GitHub variable ADMIN_URL.
ADMIN_URL=https://admin.example.com

# Slug of the one organization this deployment serves (BUSINESS_OS_ORGANIZATION_SLUG).
ORG_SLUG=example-shop

# Display name of that organization (BUSINESS_OS_ORGANIZATION_NAME).
ORG_NAME=Example Shop

# Sentry ingest DSN (a public key). none turns error reporting off.
SENTRY_DSN=https://0000000000000000@o0.ingest.example.invalid/0

# Sender of password-reset and verification e-mail, on a domain verified in Resend. none turns e-mail
# off.
RESEND_FROM_EMAIL=Example Shop <no-reply@example.com>

# Google OAuth client id for "Sign in with Google". none turns it off.
GOOGLE_LOGIN_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Redirect URI registered for that client: <ADMIN_URL>/api/auth/oauth/callback. none when sign-in is
# off.
GOOGLE_LOGIN_REDIRECT_URI=https://admin.example.com/api/auth/oauth/callback

# Google OAuth client id for the Drive backup mirror (a separate client from the login one). none
# turns it off.
GOOGLE_DRIVE_CLIENT_ID=000000000000-exampledrive.apps.googleusercontent.com

# Redirect URI registered for the Drive client: <ADMIN_URL>/api/system/drive-sync/oauth/callback. none
# when the mirror is off.
GOOGLE_DRIVE_REDIRECT_URI=https://admin.example.com/api/system/drive-sync/oauth/callback

# ---- optional shop identity (an empty line keeps the neutral default of the code) ----

# Shop name: page title, install name, two-factor issuer and storefront copy. Optional.
# For example: SHOP_NAME=Example Shop
SHOP_NAME=

# Shop name in Khmer. Optional.
# For example: SHOP_NAME_KM=(the name in Khmer script)
SHOP_NAME_KM=

# Another name customers know the shop by. Optional.
# For example: SHOP_ALIAS=Example
SHOP_ALIAS=

# Kind of shop, for storefront wording (for example beauty). Left out: general-shop wording. Optional.
# For example: SHOP_CATEGORY=general
SHOP_CATEGORY=

# Path prefix of the shop's own icon files under frontend/public (for example /my-shop-). Left out:
# the neutral Business OS icons. Optional.
# For example: SHOP_ICON_PREFIX=/example-shop-
SHOP_ICON_PREFIX=

# Name of the staff app on a phone home screen. Optional.
# For example: ADMIN_SHORT_NAME=Example Admin
ADMIN_SHORT_NAME=

# Prefix of membership numbers, for example LC- gives LC-00001. Optional.
# For example: MEMBERSHIP_PREFIX=EX-
MEMBERSHIP_PREFIX=

# ---- Worker configuration ----

# Name of a second, tiny Worker that hands every request to this client's Worker over a service
# binding, so the staff app has an address of its own on workers.dev
# (<client>-admin.<subdomain>.workers.dev). Rendered to cloudflare/admin-forwarder/wrangler.toml and
# deployed by hand (docs/setup/multi-client.md). Optional; none or empty: no forwarder.
# (optional; default )
FORWARDER_NAME=

# ---- optional comment blocks (comments only, never configuration) ----

# Comment block above workers_dev. Optional. Every line must start with #; write a line break as \n
# inside double quotes.
NOTE_WORKERS_DEV=

# Comment block above routes. Optional. Every line must start with #; write a line break as \n inside
# double quotes.
NOTE_ROUTES=

# Comment lines above [placement] in the paid file. Optional. Every line must start with #; write a
# line break as \n inside double quotes.
NOTE_PLACEMENT=

# Comment lines above [placement] in the free file. Optional. Every line must start with #; write a
# line break as \n inside double quotes.
NOTE_PLACEMENT_FREE=

# Comment lines above the organization slug. Optional. Every line must start with #; write a line
# break as \n inside double quotes.
NOTE_ORG=

# Comment lines below the e-mail sender. Optional. Every line must start with #; write a line break as
# \n inside double quotes.
NOTE_RESEND=
