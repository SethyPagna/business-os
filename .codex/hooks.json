{
  "description": "Check cross-tool agent adapters and refresh shared Git patterns when a Codex session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/agent-team/scripts/session-start.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$repoRoot = git rev-parse --show-toplevel; node (Join-Path $repoRoot 'agent-team/scripts/session-start.mjs')\"",
            "timeout": 15,
            "additionalContextLimit": 1200,
            "statusMessage": "Checking shared agent team"
          }
        ]
      }
    ]
  }
}
