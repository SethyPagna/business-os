{
  "name": "business-os-frontend",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:public-runtime",
    "build": "vite build",
    "build:public-runtime": "node ../ops/scripts/frontend/build-public-runtime-scripts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:source": "node tests/sourceSyntaxCheck.ts",
    "check:jsx": "npm run check:source",
    "preview": "vite preview",
    "smoke:local": "vite --host 127.0.0.1 --port 4173",
    "test:utils": "npm run typecheck && npm run verify:public-runtime && npm run check:source && node tests/runTests.ts",
    "verify:i18n": "node ../ops/scripts/frontend/verify-i18n.ts",
    "verify:public-runtime": "node ../ops/scripts/frontend/build-public-runtime-scripts.ts --check"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@ffmpeg/core": "^0.11.0",
    "@ffmpeg/ffmpeg": "^0.11.6",
    "@fontsource/noto-sans-khmer": "^5.2.8",
    "@zxing/browser": "0.2.0",
    "@zxing/library": "^0.22.0",
    "dexie": "^3.2.7",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
