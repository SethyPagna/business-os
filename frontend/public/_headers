# N45. The Worker sets security headers on /api/*, but the storefront HTML,
# JS and CSS are served by the static-asset layer BEFORE any Worker code
# runs, so until now the public pages carried none at all. This block is the
# only place that can reach them.
#
# The CSP is REPORT-ONLY on purpose. index.html carries a synchronous inline
# bootstrap (it swaps the manifest/icons before iOS can snapshot the page),
# so an enforcing policy needs 'unsafe-inline' for scripts -- which buys
# almost nothing. Report-only lets the real violations be collected first;
# move that bootstrap to a hashed or external script, then rename this to
# Content-Security-Policy and drop 'unsafe-inline'.
#
# The allowed origins are the storefront's real third parties and nothing
# else: the Google Maps frame (two-click, see legal/PortalEmbedConsent.tsx).
# camera=(self) stays permitted because the barcode scanner needs it.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=(), usb=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src https://www.google.com https://maps.google.com https://google.com https://www.google.com.kh https://maps.google.com.kh https://google.com.kh https://www.google.co.th https://maps.google.co.th https://google.co.th https://www.google.com.sg https://maps.google.com.sg https://google.com.sg https://www.google.co.uk https://maps.google.co.uk https://google.co.uk https://www.google.com.au https://maps.google.com.au https://google.com.au https://www.google.de https://maps.google.de https://google.de https://www.google.fr https://maps.google.fr https://google.fr https://www.google.co.jp https://maps.google.co.jp https://google.co.jp; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/portal-manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/business-os-precache.json
  Cache-Control: public, max-age=0, must-revalidate
