# Playwright E2E output (frontend/playwright.config.ts). All three are
# regenerated by every run and two of them hold binaries -- traces, videos and
# screenshots retained on failure. Nothing here belongs in git; the browsers
# themselves live in %LOCALAPPDATA%\ms-playwright, outside the repo entirely.
frontend/e2e-report/
frontend/test-results/
frontend/playwright/.cache/

# Lane-worktree preview artifacts (see frontend/vite.lane.config.ts):
# a private vite optimize cache, and the one-line Worker port for the proxy.
frontend/.vite-lane-cache/
frontend/.lane-api-port
