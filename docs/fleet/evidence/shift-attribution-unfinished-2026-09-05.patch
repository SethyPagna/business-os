+      // and timestamp before accepting it, so a later sync cannot drift onto
+      // whichever shift happens to be open at replay time.
+      shift_session_id: activeShiftState?.shift?.id ?? null,
       cashier_id:   user?.id || null,
       // Store the USERNAME as the cashier display (cashier_id is the real link).
       // Keeps new sales consistent with historical ones and with the rename

diff --git a/cloudflare/migrations/0120_shift_transaction_attribution.sql b/cloudflare/migrations/0120_shift_transaction_attribution.sql
new file mode 100644
--- /dev/null
+++ b/cloudflare/migrations/0120_shift_transaction_attribution.sql
@@ -0,0 +1,103 @@
+-- Durable shift ownership for transactional rows plus an append-only record
+-- of the two lifecycle actions that create and close a shift.
+--
+-- Existing historical sales/fees stay NULL: assigning them from overlapping
+-- timestamps would invent ownership that the old schema never recorded.
+-- New writes resolve and validate the exact shift in Worker code.
+
+ALTER TABLE sales ADD COLUMN shift_session_id INTEGER REFERENCES shift_sessions(id) ON DELETE RESTRICT;
+ALTER TABLE fees ADD COLUMN shift_session_id INTEGER REFERENCES shift_sessions(id) ON DELETE RESTRICT;
+
+CREATE INDEX idx_sales_shift_session ON sales(shift_session_id) WHERE shift_session_id IS NOT NULL;
+CREATE INDEX idx_fees_shift_session ON fees(shift_session_id) WHERE shift_session_id IS NOT NULL;
+
+CREATE TABLE shift_session_events (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  shift_session_id INTEGER NOT NULL REFERENCES shift_sessions(id) ON DELETE RESTRICT,
+  event_type TEXT NOT NULL CHECK (event_type IN ('open', 'close')),
+  actor_user_id INTEGER,
+  actor_name TEXT,
+  snapshot_json TEXT NOT NULL,
+  occurred_at TEXT NOT NULL,
+  recorded_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE INDEX idx_shift_session_events_shift_time
+  ON shift_session_events(shift_session_id, occurred_at, id);
+
+-- Triggers make lifecycle evidence atomic with the shift write. During an
+-- authorized restore they stay quiet so the backed-up event rows are restored
+-- exactly once instead of being regenerated from restored shift rows.
+CREATE TRIGGER shift_session_event_after_open
+AFTER INSERT ON shift_sessions
+WHEN NOT EXISTS (
+  SELECT 1 FROM system_flags
+  WHERE key = 'maintenance' AND json_extract(value, '$.mode') = 'restore'
+)
+BEGIN
+  INSERT INTO shift_session_events (
+    shift_session_id, event_type, actor_user_id, actor_name, snapshot_json, occurred_at
+  ) VALUES (
+    NEW.id, 'open', NEW.user_id, NEW.user_name,
+    json_object(
+      'shift_code', NEW.shift_code,
+      'scope_mode', NEW.scope_mode,
+      'user_id', NEW.user_id,
+      'user_name', NEW.user_name,
+      'branch_id', NEW.branch_id,
+      'branch_name', NEW.branch_name,
+      'business_date', NEW.business_date,
+      'opened_at', NEW.opened_at,
+      'opening_float_usd', NEW.opening_float_usd,
+      'opening_float_khr', NEW.opening_float_khr,
+      'opening_note', NEW.opening_note,
+      'opened_device_name', NEW.opened_device_name
+    ),
+    NEW.opened_at
+  );
+END;
+
+CREATE TRIGGER shift_session_event_after_close
+AFTER UPDATE OF closed_at ON shift_sessions
+WHEN OLD.closed_at IS NULL AND NEW.closed_at IS NOT NULL
+  AND NOT EXISTS (
+    SELECT 1 FROM system_flags
+    WHERE key = 'maintenance' AND json_extract(value, '$.mode') = 'restore'
+  )
+BEGIN
+  INSERT INTO shift_session_events (
+    shift_session_id, event_type, actor_user_id, actor_name, snapshot_json, occurred_at
+  ) VALUES (
+    NEW.id, 'close', NEW.closed_by_user_id, NEW.closed_by_user_name,
+    json_object(
+      'shift_code', NEW.shift_code,
+      'scope_mode', NEW.scope_mode,
+      'branch_id', NEW.branch_id,
+      'business_date', NEW.business_date,
+      'opened_at', NEW.opened_at,
+      'closed_at', NEW.closed_at,
+      'closing_counted_usd', NEW.closing_counted_usd,
+      'closing_counted_khr', NEW.closing_counted_khr,
+      'closing_note', NEW.closing_note,
+      'closed_device_name', NEW.closed_device_name,
+      'revision', NEW.revision
+    ),
+    NEW.closed_at
+  );
+END;
+
+CREATE TRIGGER shift_session_events_no_update
+BEFORE UPDATE ON shift_session_events
+BEGIN
+  SELECT RAISE(ABORT, 'shift session events are immutable');
+END;
+
+CREATE TRIGGER shift_session_events_no_delete
+BEFORE DELETE ON shift_session_events
+WHEN NOT EXISTS (
+  SELECT 1 FROM system_flags
+  WHERE key = 'maintenance' AND json_extract(value, '$.mode') = 'restore'
+)
+BEGIN
+  SELECT RAISE(ABORT, 'shift session events are immutable');
+END;

diff --git a/cloudflare/scripts/test-shift-attribution-pure.cjs b/cloudflare/scripts/test-shift-attribution-pure.cjs
new file mode 100644
--- /dev/null
+++ b/cloudflare/scripts/test-shift-attribution-pure.cjs
@@ -0,0 +1,96 @@
+// Focused server-parity checks for durable transaction -> shift ownership.
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const path = require('node:path')
+const ts = require('typescript')
+const Database = require('better-sqlite3')
+
+function loadShiftAttribution() {
+  const relPath = 'src/lib/shiftAttribution.ts'
+  const src = fs.readFileSync(path.join(__dirname, '..', relPath), 'utf8')
+  const { outputText } = ts.transpileModule(src, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 },
+    fileName: path.basename(relPath),
+  })
+  const mod = { exports: {} }
+  const requireShim = (id) => {
+    if (id === './businessDateWindow') return { BUSINESS_UTC_OFFSET_MINUTES: 420 }
+    if (id === './permissions') return { isAdminControlUser: (user) => !!user.isAdmin }
+    return {}
+  }
+  new Function('exports', 'require', 'module', outputText)(mod.exports, requireShim, mod)
+  return mod.exports
+}
+
+class CompatDb {
+  constructor(sqlite) { this.sqlite = sqlite }
+  prepare(sql) {
+    const statement = this.sqlite.prepare(sql)
+    return {
+      get: async (params = {}) => statement.get(params),
+      all: async (params = {}) => statement.all(params),
+    }
+  }
+}
+
+const sqlite = new Database(':memory:')
+sqlite.exec(`
+  CREATE TABLE settings (key TEXT PRIMARY KEY, value TEXT);
+  CREATE TABLE shift_sessions (
+    id INTEGER PRIMARY KEY, scope_mode TEXT NOT NULL, user_id INTEGER NOT NULL,
+    branch_id INTEGER, business_date TEXT NOT NULL, opened_at TEXT NOT NULL, closed_at TEXT
+  );
+  INSERT INTO settings VALUES ('shift_scope_mode','per_account'), ('shift_admin_exempt','true');
+  INSERT INTO shift_sessions VALUES
+    (1,'per_account',7,2,'2026-09-05','2026-09-05T01:00:00.000Z',NULL),
+    (2,'per_account',8,2,'2026-09-04','2026-09-04T01:00:00.000Z','2026-09-04T09:00:00.000Z'),
+    (3,'shop_wide',99,4,'2026-09-05','2026-09-05T00:30:00.000Z',NULL);
+`)
+
+const db = new CompatDb(sqlite)
+const { resolveTransactionShiftId, ShiftAttributionError } = loadShiftAttribution()
+let passed = 0
+async function check(name, fn) {
+  await fn()
+  passed += 1
+  console.log(`PASS ${name}`)
+}
+
+;(async () => {
+  await check('server resolves the caller current per-account shift', async () => {
+    assert.equal(await resolveTransactionShiftId({ db, user: { id: 7 }, branchId: 2, occurredAt: '2026-09-05T02:00:00.000Z', required: true }), 1)
+  })
+  await check('required write without caller shift is rejected', async () => {
+    await assert.rejects(
+      resolveTransactionShiftId({ db, user: { id: 9 }, branchId: 2, occurredAt: '2026-09-05T02:00:00.000Z', required: true }),
+      (error) => error instanceof ShiftAttributionError && error.code === 'shift_required',
+    )
+  })
+  await check('offline replay keeps an explicitly verified closed shift', async () => {
+    assert.equal(await resolveTransactionShiftId({
+      db, user: { id: 8 }, branchId: 2, occurredAt: '2026-09-04T05:00:00.000Z', requestedShiftId: 2, required: true,
+    }), 2)
+  })
+  await check('requested shift is rejected outside its time window or owner', async () => {
+    await assert.rejects(resolveTransactionShiftId({
+      db, user: { id: 8 }, branchId: 2, occurredAt: '2026-09-04T10:00:00.000Z', requestedShiftId: 2,
+    }), /does not own/)
+    await assert.rejects(resolveTransactionShiftId({
+      db, user: { id: 7 }, branchId: 2, occurredAt: '2026-09-04T05:00:00.000Z', requestedShiftId: 2,
+    }), /does not own/)
+  })
+  await check('shop-wide requested shift accepts another employee in its branch', async () => {
+    assert.equal(await resolveTransactionShiftId({
+      db, user: { id: 7 }, branchId: 4, occurredAt: '2026-09-05T02:00:00.000Z', requestedShiftId: 3,
+    }), 3)
+  })
+  await check('admin exemption intentionally leaves the transaction unlinked', async () => {
+    assert.equal(await resolveTransactionShiftId({
+      db, user: { id: 1, isAdmin: true }, branchId: null, occurredAt: '2026-09-05T02:00:00.000Z', required: true,
+    }), null)
+  })
+  console.log(`\n${passed} shift attribution checks passed`)
+})().catch((error) => {
+  console.error(error)
+  process.exitCode = 1
+})

diff --git a/cloudflare/src/lib/shiftAttribution.ts b/cloudflare/src/lib/shiftAttribution.ts
new file mode 100644
--- /dev/null
+++ b/cloudflare/src/lib/shiftAttribution.ts
@@ -0,0 +1,91 @@
+import type { SessionUser } from './auth'
+import { BUSINESS_UTC_OFFSET_MINUTES } from './businessDateWindow'
+import type { D1Compat } from './db'
+import { isAdminControlUser } from './permissions'
+
+export type ShiftScopeMode = 'per_account' | 'shop_wide'
+export type ShiftPolicy = { scope_mode: ShiftScopeMode; admin_exempt: boolean }
+
+export class ShiftAttributionError extends Error {
+  constructor(message: string, readonly code: 'invalid_shift' | 'shift_required') {
+    super(message)
+    this.name = 'ShiftAttributionError'
+  }
+}
+
+export async function readShiftPolicy(db: D1Compat): Promise<ShiftPolicy> {
+  const rows = await db.prepare("SELECT key, value FROM settings WHERE key IN ('shift_scope_mode', 'shift_admin_exempt')")
+    .all<{ key: string; value: string }>()
+  const values = Object.fromEntries(rows.map((row) => [row.key, row.value]))
+  return {
+    scope_mode: values.shift_scope_mode === 'shop_wide' ? 'shop_wide' : 'per_account',
+    admin_exempt: values.shift_admin_exempt == null ? true : values.shift_admin_exempt !== 'false',
+  }
+}
+
+function businessDateFor(iso: string): string {
+  return new Date(new Date(iso).getTime() + BUSINESS_UTC_OFFSET_MINUTES * 60 * 1000).toISOString().slice(0, 10)
+}
+
+function optionalPositiveId(value: unknown): number | null {
+  if (value == null || String(value).trim() === '') return null
+  const id = Number(value)
+  return Number.isSafeInteger(id) && id > 0 ? id : null
+}
+
+type ResolveShiftInput = {
+  db: D1Compat
+  user: SessionUser
+  branchId: number | null
+  occurredAt: string
+  requestedShiftId?: unknown
+  required?: boolean
+}
+
+/**
+ * Resolve the shift that owns a new transaction.
+ *
+ * A client-supplied id is never trusted by itself: it must belong to the
+ * transaction branch, cover the transaction timestamp, and either be the
+ * caller's per-account shift or a shop-wide shift. This is what lets an
+ * offline POS sale keep its queue-time shift after that shift has closed,
+ * without attaching arbitrary historical rows by timestamp alone.
+ */
+export async function resolveTransactionShiftId(input: ResolveShiftInput): Promise<number | null> {
+  const { db, user, branchId, occurredAt } = input
+  const policy = await readShiftPolicy(db)
+  if (policy.admin_exempt && isAdminControlUser(user)) return null
+
+  const hasRequestedValue = input.requestedShiftId != null && String(input.requestedShiftId).trim() !== ''
+  const requestedShiftId = optionalPositiveId(input.requestedShiftId)
+  if (hasRequestedValue && requestedShiftId == null) {
+    throw new ShiftAttributionError('Invalid shift session.', 'invalid_shift')
+  }
+
+  if (requestedShiftId != null) {
+    const row = await db.prepare(`SELECT id FROM shift_sessions
+      WHERE id=@id
+        AND ((@branchId IS NULL AND branch_id IS NULL) OR branch_id=@branchId)
+        AND (scope_mode='shop_wide' OR user_id=@userId)
+        AND opened_at<=@occurredAt
+        AND (closed_at IS NULL OR closed_at>=@occurredAt)
+      LIMIT 1`).get<{ id: number }>({ id: requestedShiftId, branchId, userId: user.id, occurredAt })
+    if (!row) throw new ShiftAttributionError('The selected shift does not own this transaction.', 'invalid_shift')
+    return row.id
+  }
+
+  const accountClause = policy.scope_mode === 'per_account' ? 'AND user_id=@userId' : ''
+  const row = await db.prepare(`SELECT id FROM shift_sessions
+    WHERE scope_mode=@scopeMode ${accountClause}
+      AND business_date=@businessDate AND closed_at IS NULL
+      AND ((@branchId IS NULL AND branch_id IS NULL) OR branch_id=@branchId)
+    ORDER BY opened_at DESC, id DESC LIMIT 1`).get<{ id: number }>({
+      scopeMode: policy.scope_mode,
+      userId: user.id,
+      branchId,
+      businessDate: businessDateFor(occurredAt),
+    })
+  if (row) return row.id
+  if (input.required) throw new ShiftAttributionError('Register an open shift before recording this transaction.', 'shift_required')
+  return null
+}

