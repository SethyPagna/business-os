{
  "name": "business-os-ops",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "clean-generated:preview": "powershell -ExecutionPolicy Bypass -File scripts/powershell/clean-generated.ps1 -Preview",
    "cleanup-node-processes:preview": "powershell -ExecutionPolicy Bypass -File scripts/powershell/clear-stale-node-processes.ps1",
    "cleanup-node-processes": "powershell -ExecutionPolicy Bypass -File scripts/powershell/clear-stale-node-processes.ps1 -Apply",
    "cleanup-node-processes:codex": "powershell -ExecutionPolicy Bypass -File scripts/powershell/clear-stale-node-processes.ps1 -Apply -IncludeCodexHelpers",
    "action-history:check": "node scripts/runtime/audits/action-history-undo-redo-check.ts",
    "deep-live-audit": "node scripts/runtime/audits/deep-live-audit.ts --profile exhaustive",
    "browser-action-smoke": "node scripts/runtime/browser-action-smoke.ts --profile exhaustive",
    "generated-bulk-audit": "node scripts/architecture/generated-bulk-audit.ts",
    "language-runtime-audit": "node scripts/architecture/language-runtime-audit.ts",
    "phase29:audit": "node scripts/architecture/phase29-audit.ts",
    "cleanup-test-data": "node scripts/runtime/storage/cleanup-test-data.ts",
    "cleanup-test-data:check": "node scripts/runtime/storage/cleanup-test-data.ts --all-qa --dry-run --fail-on-match",
    "cleanup-test-data:check-smoke": "node scripts/runtime/storage/cleanup-test-data.ts --prefix \"QA Smoke\" --dry-run --fail-on-match",
    "cleanup-test-data:check-action-history": "node scripts/runtime/storage/cleanup-test-data.ts --prefix \"QA Action History\" --dry-run --fail-on-match",
    "cleanup-integrity-backlog": "node scripts/runtime/storage/cleanup-integrity-backlog.ts --dry-run --output ops/runtime/reports/cleanup-integrity-backlog-preview-latest.json",
    "cleanup-integrity-backlog:apply": "node scripts/runtime/storage/cleanup-integrity-backlog.ts --apply --output ops/runtime/reports/cleanup-integrity-backlog-apply-latest.json",
    "post-live-hygiene": "node scripts/runtime/storage/post-live-hygiene.ts",
    "live-hygiene:check": "node scripts/runtime/storage/post-live-hygiene.ts",
    "phase84:live-suite": "node scripts/runtime/live-checks/phase84-live-suite.ts",
    "dataset-readiness": "node scripts/runtime/storage/dataset-readiness.ts --output ops/runtime/reports/dataset-readiness-latest.json",
    "dataset-readiness:loaded": "node scripts/runtime/storage/dataset-readiness.ts --fail-if-empty --output ops/runtime/reports/dataset-readiness-latest.json",
    "restore-candidates": "node scripts/runtime/storage/restore-candidates.ts --output ops/runtime/reports/restore-candidates-latest.json",
    "restore-candidates:loaded": "node scripts/runtime/storage/restore-candidates.ts --fail-if-no-loaded --output ops/runtime/reports/restore-candidates-latest.json",
    "restore-rehearsal": "node scripts/runtime/storage/restore-rehearsal.ts --output ops/runtime/reports/restore-rehearsal-latest.json",
    "schema-pk-preflight": "node scripts/backend/schema-primary-key-preflight.ts",
    "schema-pk-preflight:strict": "node scripts/backend/schema-primary-key-preflight.ts --fail-on-blocker",
    "phase29:audit:repeat": "node scripts/architecture/phase29-audit.ts --repeat 3",
    "prune-storage": "node scripts/runtime/storage/prune-storage.ts",
    "prune-storage:preview": "node scripts/runtime/storage/prune-storage.ts --dry-run --skip-remote --output ops/runtime/reports/prune-storage-preview-latest.json",
    "public-runtime:build": "node scripts/frontend/build-public-runtime-scripts.ts",
    "public-runtime:check": "node scripts/frontend/build-public-runtime-scripts.ts --check"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
