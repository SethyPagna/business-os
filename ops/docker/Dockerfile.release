# syntax=docker/dockerfile:1

FROM node:24-bookworm AS frontend-build
ARG BUILD_COMMIT=dev
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --loglevel=warn
COPY ops/scripts/frontend/ /build/ops/scripts/frontend/
COPY frontend/ ./
RUN printf '%s\n' "$BUILD_COMMIT" > .build-commit
RUN BUSINESS_OS_BUILD_REVISION="$BUILD_COMMIT" npm run build

FROM node:24-bookworm AS backend-build
ARG BUILD_COMMIT=dev
WORKDIR /build/backend
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ libpq-dev \
  && rm -rf /var/lib/apt/lists/*
COPY backend/package*.json ./
RUN npm ci --omit=dev --no-audit --loglevel=warn \
  && npm install pg-native@3.7.0 --no-save --no-audit --loglevel=warn \
  && npm ls pg-native libpq
COPY ops/scripts/backend/ /build/ops/scripts/backend/
COPY --from=frontend-build /build/frontend/package.json /build/frontend/package.json
COPY --from=frontend-build /build/frontend/node_modules/typescript /build/frontend/node_modules/typescript
COPY backend/ ./
COPY --from=frontend-build /build/frontend/dist ./frontend-dist
RUN npm run build:server-entry \
  && node ../ops/scripts/backend/build-package-stage.ts

FROM node:24-bookworm-slim AS runtime
ARG BUILD_COMMIT=dev
LABEL org.opencontainers.image.title="Business OS"
LABEL org.opencontainers.image.description="Business OS Docker runtime"
LABEL org.opencontainers.image.source="private"

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tini ffmpeg libpq5 \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --create-home --home-dir /app --shell /usr/sbin/nologin businessos

WORKDIR /app
COPY --from=backend-build /build/backend/.pkg-stage/ /app/
COPY --from=backend-build /build/backend/node_modules /app/node_modules
RUN ln -s /app/node_modules/sharp /app/sharp \
  && ln -s /app/node_modules/@img /app/@img \
  && mkdir -p /runtime \
  && chown -R businessos:businessos /runtime /app

ENV NODE_ENV=production \
    PORT=4000 \
    BUSINESS_OS_BUILD_REVISION=${BUILD_COMMIT} \
    BUSINESS_OS_RUNTIME_DIR=/runtime \
    BUSINESS_OS_RUNTIME=docker \
    BUSINESS_OS_DOCKER_RELEASE=1 \
    BUSINESS_OS_DOCKER_DATA_MODE=postgres \
    BUSINESS_OS_POSTGRES_CUTOVER_VERIFIED=1 \
    BUSINESS_OS_REQUIRE_SCALE_SERVICES=1 \
    DATABASE_DRIVER=postgres \
    OBJECT_STORAGE_DRIVER=r2 \
    ANALYTICS_ENGINE=duckdb \
    PARQUET_STORE=r2 \
    JOB_QUEUE_DRIVER=bullmq \
    WORKER_RUNTIME=docker

USER businessos
EXPOSE 4000
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/server.js"]
