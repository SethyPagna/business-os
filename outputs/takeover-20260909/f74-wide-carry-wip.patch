+export function customerCarryProjection(input: {
+  targetId: number
+  afterName: string | null
+  afterPhone: string | null
+  afterAddress: string | null
+  beforeMembership: string | null
+  afterMembership: string | null
+  carryName: boolean
+  carryPhone: boolean
+  carryAddress: boolean
+  carryMembership: boolean
+}): SaleReferenceProjection {
+  const targetId = positiveId(input.targetId, 'target_id')
+  const params: Record<string, unknown> = {
+    saleReferenceTargetId: targetId,
+    saleReferenceAfterName: input.afterName,
+    saleReferenceAfterPhone: input.afterPhone,
+    saleReferenceAfterAddress: input.afterAddress,
+    saleReferenceBeforeMembership: input.beforeMembership,
+    saleReferenceAfterMembership: input.afterMembership,
+    saleReferenceCarryName: input.carryName ? 1 : 0,
+    saleReferenceCarryPhone: input.carryPhone ? 1 : 0,
+    saleReferenceCarryAddress: input.carryAddress ? 1 : 0,
+    saleReferenceCarryMembership: input.carryMembership ? 1 : 0,
+  }
+  const nameDiff = `@saleReferenceCarryName=1 AND s.customer_name IS NOT @saleReferenceAfterName`
+  const phoneDiff = `@saleReferenceCarryPhone=1 AND s.customer_phone IS NOT @saleReferenceAfterPhone`
+  const addressDiff = `@saleReferenceCarryAddress=1 AND s.customer_address IS NOT @saleReferenceAfterAddress`
+  const membershipDiff = `@saleReferenceCarryMembership=1 AND @saleReferenceBeforeMembership IS NOT @saleReferenceAfterMembership`
+  const customerBefore = `json_object('id',@saleReferenceTargetId,'name',s.customer_name)`
+  const customerAfter = `json_object('id',@saleReferenceTargetId,'name',@saleReferenceAfterName)`
+  const customerChange = `json_object('field','customer','before',json(${knownValueSql(customerBefore)}),'after',json(${knownValueSql(customerAfter)}))`
+  const membershipChange = `json_object('field','membership','before',json(${membershipStateSql('@saleReferenceBeforeMembership')}),'after',json(${membershipStateSql('@saleReferenceAfterMembership')}))`
+  const changes = `CASE
+    WHEN name_changed=1 AND membership_changed=1 THEN json_array(json(${customerChange}),json(${membershipChange}))
+    WHEN name_changed=1 THEN json_array(json(${customerChange}))
+    WHEN membership_changed=1 THEN json_array(json(${membershipChange}))
+    ELSE json_array()
+  END`
+  const metadata = `CASE
+    WHEN phone_changed=1 AND address_changed=1 THEN json_object('changed_contact_fields',json_array('address','phone'))
+    WHEN phone_changed=1 THEN json_object('changed_contact_fields',json_array('phone'))
+    WHEN address_changed=1 THEN json_object('changed_contact_fields',json_array('address'))
+    ELSE NULL
+  END`
+  return {
+    params,
+    sharedCtes: `WITH mutationCandidates AS (
+      SELECT s.id AS sale_id,s.customer_name,s.customer_phone,s.customer_address,
+        CASE WHEN ${nameDiff} THEN 1 ELSE 0 END AS name_changed,
+        CASE WHEN ${phoneDiff} THEN 1 ELSE 0 END AS phone_changed,
+        CASE WHEN ${addressDiff} THEN 1 ELSE 0 END AS address_changed,
+        CASE WHEN ${membershipDiff} THEN 1 ELSE 0 END AS membership_changed
+      FROM sales s
+      WHERE s.customer_id=@saleReferenceTargetId
+        AND (${nameDiff} OR ${phoneDiff} OR ${addressDiff} OR ${membershipDiff})
+    ), eventValues AS (
+      SELECT sale_id,
+        CASE WHEN name_changed=1 OR membership_changed=1 THEN 'customer_changed' ELSE 'customer_contact_changed' END AS kind,
+        ${changes} AS changes_json,
+        ${metadata} AS metadata_json
+      FROM mutationCandidates s
+    ), eventProjection AS (
+      SELECT *,json_object(
+        'sale_id',sale_id,'source_kind','contact_customer_carry','source_id','00000000-0000-4000-8000-000000000000',
+        'generation',0,'kind',kind,'via','apply','actor_id',0,
+        'occurred_at','0000-00-00T00:00:00.000Z','changes',json(changes_json),
+        'metadata',CASE WHEN metadata_json IS NULL THEN NULL ELSE json(metadata_json) END
+      ) AS projected_event_json
+      FROM eventValues
+    )`,
+  }
+}
+
+export function deliveryCarryProjection(input: { targetId: number; afterName: string | null }): SaleReferenceProjection {
+  const targetId = positiveId(input.targetId, 'target_id')
+  const driverBefore = `json_object('id',@saleReferenceTargetId,'name',s.delivery_contact_name,'phone',NULL,'address',NULL)`
+  const driverAfter = `json_object('id',@saleReferenceTargetId,'name',@saleReferenceAfterName,'phone',NULL,'address',NULL)`
+  const changes = `json_array(json_object(
+    'field','driver',
+    'before',json(${knownValueSql(driverBefore)}),
+    'after',json(${knownValueSql(driverAfter)})
+  ))`
+  return {
+    params: { saleReferenceTargetId: targetId, saleReferenceAfterName: input.afterName },
+    sharedCtes: `WITH mutationCandidates AS (
+      SELECT s.id AS sale_id,s.delivery_contact_name
+      FROM sales s
+      WHERE s.delivery_contact_id=@saleReferenceTargetId
+        AND s.delivery_contact_name IS NOT @saleReferenceAfterName
+    ), eventValues AS (
+      SELECT sale_id,'driver_changed' AS kind,${changes} AS changes_json,NULL AS metadata_json
+      FROM mutationCandidates s
+    ), eventProjection AS (
+      SELECT *,json_object(
+        'sale_id',sale_id,'source_kind','contact_delivery_carry','source_id','00000000-0000-4000-8000-000000000000',
+        'generation',0,'kind',kind,'via','apply','actor_id',0,
+        'occurred_at','0000-00-00T00:00:00.000Z','changes',json(changes_json),'metadata',NULL
+      ) AS projected_event_json
+      FROM eventValues
+    )`,
+  }
+}
+
+export function saleReferenceEventInsert(input: {
+  projection: SaleReferenceProjection
+  sourceKind: 'contact_customer_carry' | 'contact_delivery_carry' | 'contact_customer_merge' | 'contact_delivery_merge' | 'customer_link_repair' | 'customer_missing_resolve' | 'payment_method_replace'
+  receiptId: string
