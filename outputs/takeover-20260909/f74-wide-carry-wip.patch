+    sql: `${input.projection.sharedCtes}
+      INSERT INTO sale_record_events(
+        id,sale_id,source_kind,source_id,generation,kind,via,subject,actor_id,
+        actor_username,occurred_at,changes_json,metadata_json,request_digest,response_json
+      )
+      SELECT ${EVENT_UUID_SQL},sale_id,@saleReferenceSourceKind,@saleReferenceReceiptId,0,kind,'apply',NULL,
+        @saleReferenceActorId,@saleReferenceActorUsername,@saleReferenceOccurredAt,changes_json,metadata_json,
+        @saleReferenceRequestDigest,NULL
+      FROM eventProjection`,
+    params: {
+      ...input.projection.params,
+      saleReferenceSourceKind: input.sourceKind,
+      saleReferenceReceiptId: input.receiptId,
+      saleReferenceActorId: input.actorId,
+      saleReferenceActorUsername: input.actorUsername,
+      saleReferenceOccurredAt: input.occurredAt,
+      saleReferenceRequestDigest: input.requestDigest,
+    },
+  }
+}
