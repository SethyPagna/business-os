{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/agent-team/scripts/session-start.mjs"],
            "timeout": 15,
            "statusMessage": "Checking shared agent team"
          }
        ]
      }
    ]
  }
}
