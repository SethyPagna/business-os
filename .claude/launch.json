{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin (production)",
      "url": "https://admin.leangbeauty.com"
    },
    {
      "name": "store (production)",
      "url": "https://leangbeauty.com"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-b",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "worker-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        "cloudflare/wrangler.toml",
        "--port",
        "8787"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "worker-dev-b",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        "cloudflare/wrangler.toml",
        "--port",
        "8899"
      ],
      "port": 8899,
      "autoPort": false
    }
  ]
}
