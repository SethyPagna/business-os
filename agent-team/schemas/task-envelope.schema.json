{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "role", "objective", "base_sha", "mode", "ownership", "acceptance_criteria", "verification", "side_effect_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "role": {"enum": ["feature-planner", "product-designer", "business-os-architect", "security-reviewer", "build-fixer", "implementation-worker", "playwright-tester", "go-reviewer", "skill-miner", "docs-researcher", "verifier", "reconciler"]},
    "objective": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mode": {"enum": ["read_only", "workspace_write"]},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[*?\\[\\]])(?!.*[ .](?:[\\\\/]|$)).+$"}, "uniqueItems": true},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[*?\\[\\]])(?!.*[ .](?:[\\\\/]|$)).+$"}, "uniqueItems": true}
      }
    },
    "worktree": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "side_effect_policy": {"enum": ["none", "workspace_only", "user_authorization_required"]},
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"allowed": {"type": "boolean"}, "max_depth": {"type": "integer", "minimum": 0, "maximum": 2}}
    }
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "workspace_write"}}}, "then": {"required": ["worktree", "branch"], "properties": {"ownership": {"properties": {"include": {"minItems": 1}}}}}}]
}
